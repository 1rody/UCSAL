import java.util.Scanner;
public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int[][] matriz = new int[3][3];
        int[][] at = new int[3][3];

        System.out.println("Insira os valores da matriz");
        for (int i = 0; i < 3; i++) {
            for (int k = 0; k < 3; k++) {
                matriz[i][k] = sc.nextInt();
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int k = 0; k < 3; k++) {
                at[k][i] = matriz[i][k];
            }
        }
        for (int i = 0; i < 3; i++) {
            for (int k = 0; k < 3; k++) {
                System.out.print(at[i][k] + " ");
            }
            System.out.println(" ");
        }
    }
}

